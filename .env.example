# Скопіюйте цей файл у .env і підставте свої значення.
# Файл .env у Git потрапляти НЕ повинен (він у .gitignore).

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Згенерувати токен:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN="замініть_на_довгий_випадковий_токен"
APP_TITLE="Електронний журнал"
APP_VERSION="1.0"
